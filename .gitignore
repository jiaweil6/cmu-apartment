# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env files (only the example is committed)
!.env.example

# OpenTripPlanner working files (refresh-transit workflow)
/otp-run/
*.osm.pbf

# Website survey output (scripts/inspect-sites); uploaded as a workflow artifact instead
/scripts/refresh/__fixtures__/sites/

# MapLibre worker, copied from node_modules before dev and build (scripts/map/copy-worker.mjs)
/public/basemap/maplibre-gl-worker.mjs
